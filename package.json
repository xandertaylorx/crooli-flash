{
  "name": "crooli-flash",
  "productName": "Crooli Flash",
  "version": "1.0.1",
  "description": "A calm, fast USB tool for Mac and Windows. Flash an ISO, verify it, or format a drive.",
  "author": "Crooli <info@tizzle.org> (https://crooli.com)",
  "homepage": "https://crooli.com/flash",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev:drives": "CROOLI_FLASH_DEV=1 electron .",
    "test": "node scripts/test-worker.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.crooli.flash",
    "productName": "Crooli Flash",
    "copyright": "Copyright © Crooli",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Crooli-Flash-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Crooli-Flash-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "src/main/worker.js"
    ]
  }
}
